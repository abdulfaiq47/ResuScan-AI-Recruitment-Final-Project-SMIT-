# ─────────────────────────────────────────────────────────────────────────────
#  AI Recruitment Assistant — API keys
#  Copy this file to ".env" and paste your keys. You only need ONE of them,
#  the app auto-selects the best FREE model from whatever keys it finds.
# ─────────────────────────────────────────────────────────────────────────────

# 1) OpenRouter  — https://openrouter.ai/keys        (huge catalogue of ":free" models)
OPENROUTER_API_KEY=

# 2) NVIDIA NIM  — https://build.nvidia.com/          (free credits, key starts with "nvapi-")
NVIDIA_API_KEY=

# 3) Google Gemini — https://aistudio.google.com/apikey  (free tier)
GOOGLE_API_KEY=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Force a specific provider instead of auto-select: openrouter | nvidia | gemini
FORCE_PROVIDER=
# Force a specific model id (must belong to the forced/available provider)
FORCE_MODEL=
# Sampling temperature for the analysis chains (low = consistent scoring)
LLM_TEMPERATURE=0.1
